# Correlation id for end-to-end tracing: forward the browser's X-Request-ID when
# present, otherwise mint one at the edge ($request_id) so every request carries
# one. The bridge re-validates it, so a forged/oversized client value is harmless.
map $http_x_request_id $req_id {
  ""      $request_id;
  default $http_x_request_id;
}

server {
  listen 80;

  # TLS listener and upstream SSL verification (generated at container startup
  # by entrypoint-nginx-tls.sh).  The glob pattern ensures Nginx starts cleanly
  # in local dev where no entrypoint runs and the file does not exist.
  include /etc/nginx/conf.d/tls.inc*;

  server_name _;

  # Hide the nginx version banner from responses (info-disclosure hardening).
  server_tokens off;

  # Trust real client IP from NPM (which sits in front on the `proxy` docker network).
  # `set_real_ip_from` restricts honoring the header to connections from the proxy
  # network; anything else falls back to the actual TCP peer, so external clients
  # cannot spoof their IP. CIDR matches Dennis's `proxy` network exactly — verify
  # with `docker network inspect proxy` if the network is ever recreated.
  set_real_ip_from 10.0.9.0/24;
  real_ip_header CF-Connecting-IP;
  real_ip_recursive on;

  # Browser security headers (CSP, HSTS, COOP/CORP, …). One shared file, because
  # a location that sets its own add_header loses these unless it includes it too.
  include /etc/nginx/snippets/security-headers.conf;

  # Compression for the static app (plan 45). The build ships a .gz next to each
  # text asset (Dockerfile), served by gzip_static at no CPU cost; gzip on covers
  # anything else. Every /api/ location below keeps its own `gzip off` (streamed
  # and proxied bodies are never compressed here), so this only reaches static files.
  gzip on;
  gzip_static on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain application/manifest+json;

  # Keep request bodies bounded; the app also validates lower logical limits.
  client_max_body_size 50M;

  # Give users enough time to upload larger bodies
  client_body_timeout 60s;

  root /usr/share/nginx/html;
  index index.html;

  # Defer DNS resolution to request time so nginx starts even if backend is down.
  # Note: proxy_pass with a variable skips automatic URI stripping, so we use
  # rewrite to manually strip the /api/ prefix before forwarding.
  resolver 127.0.0.11 valid=10s;
  set $bff ${BFF_BASE_URL};

  # Proxy API requests to backend service inside docker network
  location ^~ /api/v1/attachments/preview/ {
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self';" always;

    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_request_buffering off;
    proxy_buffering off;
    gzip off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location ^~ /api/v1/attachments/public/ {
    # Office Online (embed.aspx) is the only legitimate cross-origin reader, and
    # Microsoft fetches the doc server-side (no Origin header) — so this scoping
    # does NOT gate the viewer; it only stops arbitrary sites' JS from reading
    # the blob with a leaked short-lived token. Never widen back to "*".
    add_header Access-Control-Allow-Origin "https://view.officeapps.live.com" always;
    add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Range, Content-Type" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    if ($request_method = OPTIONS) {
      return 204;
    }

    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;
    proxy_request_buffering off;
    proxy_buffering off;
    gzip off;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }

  # Inference run routes: REST (start, cancel, list) and the SSE event stream
  # (…/events) share this prefix. Same upstream as /api/ but with no buffering
  # or compression, so every SSE event leaves the moment the bridge writes it,
  # and long timeouts so live-tailing streams aren't dropped by an
  # idle-connection cap.
  location ^~ /api/v1/inference/runs/ {
    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;

    # HTTP/1.1 to the bridge without a hop-by-hop `Connection: close`.
    proxy_set_header Connection "";

    proxy_request_buffering off;
    proxy_buffering off;
    gzip off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # nginx hides every X-Accel-* response header by default. Pass the bridge's
    # `X-Accel-Buffering: no` on, so Nginx Proxy Manager (in front of us on
    # Dennis, buffering by default) streams the SSE events instead of holding
    # them — buffering there would bring back the bursty streaming.
    proxy_pass_header X-Accel-Buffering;
  }

  # Background-task streams (plan 41), over SSE: the conversation channel
  # (/v1/conversations/{user}/{conv}/events) and one task's drill-down
  # (/v1/tasks/{user}/{task}/events). Only the exact `/events` paths match, so
  # the REST routes under the same prefixes stay on the generic /api/ block.
  # They need the long timeouts (the channel stays open as long as the
  # conversation is) and the X-Accel-Buffering pass-through below.
  # A regex location wins over the plain /api/ prefix below.
  location ~ ^/api/v1/(conversations|tasks)/[^/]+/[^/]+/events$ {
    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;

    proxy_set_header Connection "";

    proxy_buffering off;
    gzip off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # Same as the run location: let the bridge's `X-Accel-Buffering: no` reach
    # Nginx Proxy Manager so it streams the SSE events instead of holding them.
    proxy_pass_header X-Accel-Buffering;
  }

  # The bridge's API docs and OpenAPI schema never leave the server: they map
  # every route. The bridge only serves them in development anyway; this keeps
  # them off the edge even if that ever changes. (A regex location wins over
  # the plain /api/ prefix below.)
  location ~ ^/api/(docs|redoc|openapi\.json)(/|$) {
    return 404;
  }

  # Service-to-service-only endpoints. The bridge guards these with the internal
  # proxy secret, but nginx injects that same secret on browser traffic — so we
  # MUST block the path at the edge or a browser could reach it. The agents
  # service calls the bridge directly on the backend network, never through
  # nginx, so denying here keeps /v1/internal/* server-to-server only.
  # (^~ takes priority over the generic /api/ prefix below.)
  location ^~ /api/v1/internal/ {
    return 404;
  }

  location /api/ {
    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;

    # Forward Range headers for partial content support
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;

    # Helpful for big requests: stream directly to backend instead of buffering to disk
    proxy_request_buffering off;

    # Don't buffer responses; stream to client for SSE and long downloads
    proxy_buffering off;

    gzip off;  # or ensure octet-stream isn't in gzip_types

    # Avoid premature timeouts while backend reads/processes big bodies
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Liveness probe for the container healthcheck — answered with a bare 200 and
  # kept out of the access log so the 30s wget probe doesn't spam it.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Vite's build output: every file name carries a content hash, so a file's
  # bytes never change under its name and the browser may keep it for a year
  # without asking again. A missing chunk (an old tab after a release) is a real
  # 404, never index.html served as JavaScript.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Brand images (logos, orbs) keep fixed names, so they get a day, not a year:
  # a redesigned image reaches everyone within a day.
  location /brand/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=86400" always;
    try_files $uri =404;
  }

  # The app shell names the current hashed chunks, so it is always revalidated
  # (a cheap 304 via ETag) and a release is picked up on the next load. The SPA
  # fallback below lands here too.
  location = /index.html {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  # Single Page App routing: client routes fall back to the app shell.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
